# Backup/recovery runbook env (copy to .env.backup.local)
# Keep this file private; never commit real credentials.

# Primary (source) production DB connection string
SUPABASE_DB_URL=postgresql://postgres:password@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Restore drill target DB connection string (must be a disposable/staging DB)
SUPABASE_RESTORE_DB_URL=postgresql://postgres:password@db.YOUR_DRILL_PROJECT_REF.supabase.co:5432/postgres

# Safety guard for restore drill. Must be exactly "yes" to run.
SUPABASE_RESTORE_CONFIRM=no

# Optional: choose a specific backup set folder name under SUPABASE_BACKUP_DIR
# SUPABASE_RESTORE_BACKUP_SET=2026-03-27T15-30-00Z

# Optional: where backup sets are written
SUPABASE_BACKUP_DIR=backups/supabase

# Optional: prune backup sets older than this many days
SUPABASE_BACKUP_RETENTION_DAYS=14

# Optional: comma-separated schemas
SUPABASE_BACKUP_SCHEMAS=public,auth,storage

# Optional: absolute path to PostgreSQL client bin dir (contains pg_dump and pg_dumpall)
# Useful on Windows when binaries are installed but not added to PATH.
# SUPABASE_PG_BIN_DIR=C:\Program Files\PostgreSQL\17\bin
