# Copy to .env.local and fill in from Supabase: Project Settings → API
# https://supabase.com/dashboard

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key
VITE_APP_URL=https://your-production-origin.com
VITE_GEMINI_API_KEY=your_browser_exposed_gemini_key
VITE_MONITORING_ENDPOINT=
# Optional: lightweight shared key for monitoring-ingest. Public in browser; do not treat as secret.
VITE_MONITORING_INGEST_KEY=
VITE_MONITORING_ALERT_THRESHOLD=5
VITE_MONITORING_ALERT_WINDOW_MS=300000
VITE_SIGNUP_CHALLENGE_ENABLED=true
VITE_SIGNUP_CHALLENGE_ALWAYS=false
VITE_SIGNUP_RISK_ATTEMPTS_THRESHOLD=3
VITE_SIGNUP_RISK_WINDOW_MINUTES=10

# Payments (web): default stripe_web. Optional: revenuecat_native shows a message on web (use native app for IAP).
# VITE_PAYMENT_WEB_CHANNEL=stripe_web
# Web Token Shop checkout options, in display order (default: stripe_card).
# stripe_card | paystack_card | paystack_mobile_money (MTN MoMo, Telecel Cash, AirtelTigo Money, M-Pesa)
# VITE_PAYMENT_WEB_METHODS=paystack_mobile_money,paystack_card,stripe_card

# RevenueCat public SDK keys (Capacitor iOS / Android — safe in the client bundle).
# VITE_REVENUECAT_IOS_API_KEY=appl_...
# VITE_REVENUECAT_GOOGLE_API_KEY=goog_...

# Optional: leave unset to use mock signup (localStorage only) for UI dev without Supabase.
# Never put SUPABASE_SERVICE_ROLE_KEY in frontend env files (.env.local / VITE_*).

# RLS tests (npm run test:rls): copy rls-test.env.example → .env.rls.local and fill in.
# Do not commit .env.rls.local; keep test account passwords out of .env.local if you prefer.
