{
  "name": "zongo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "validate:migrations": "node scripts/validate-migrations.mjs",
    "ci:checks": "npm run typecheck && npm run lint && npm run build && npm run validate:migrations",
    "preview": "vite preview",
    "cap:sync": "npm run build && npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "tunnel": "npx --yes localtunnel --port 3000",
    "check:secrets": "node scripts/secret-scan.mjs",
    "test:rls": "node scripts/rls-negative-test.mjs",
    "setup:hooks": "node scripts/setup-hooks.mjs",
    "supabase:migrate": "node scripts/supabase-apply-migrations.mjs",
    "supabase:restore": "python scripts/supabase-restore-if-paused.py",
    "supabase:backup": "node scripts/supabase-backup.mjs",
    "supabase:restore:drill": "node scripts/supabase-restore-drill.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/ios": "^8.3.4",
    "@google/genai": "^1.34.0",
    "@revenuecat/purchases-capacitor": "^13.1.1",
    "@supabase/supabase-js": "^2.100.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.57.2",
    "vite": "^6.2.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
